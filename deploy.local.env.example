# 复制成 deploy.local.env 再改（deploy.local.env 不提交到 git）。
# scripts/deploy.sh 和 scripts/setup-server.sh 会读取这里的设置。

# ssh 主机名：Mac 上能直接 `ssh 这个名字` 登录服务器（在 ~/.ssh/config 里配置）
NOTE_DEPLOY_HOST=my-server

# 笔记用的域名（不带 https://）
NOTE_DOMAIN=note.example.com

# 证书目录（里面有 fullchain.pem 和 privkey.pem）；不写就用 /etc/letsencrypt/live/<域名>
# NOTE_CERT_DIR=/etc/letsencrypt/live/example.com
